{
  "name": "deepl-proxy",
  "version": "1.0.0",
  "description": "DeepL translation proxy - Node.js server and Cloudflare Worker",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node icon-preservation.test.js",
    "test:verify": "node icon-position-verification.test.js",
    "test:all": "npm test && npm run test:verify",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "worker:deploy:staging": "wrangler deploy --env staging"
  },
  "keywords": [
    "deepl",
    "translation",
    "proxy",
    "cloudflare",
    "worker"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5"
  }
}
