# Origin to proxy (EDS preview URL for the target repo/branch).
TARGET_ORIGIN=https://main--adb-dev-live--hminst.preview.da.live

# DA org/repo/ref this content lives in. Not secret - only used to build
# Source/Admin API URLs, and is exposed to the browser via GET /__editor/config.
DA_ORG=hminst
DA_REPO=adb-dev-live
DA_REF=main

# Local port for this proxy server.
PORT=4000

# There is no token here. The DA/IMS bearer token is resolved and stored
# entirely in the browser (sessionStorage) via the inspector panel's
# "Connect to DA" prompt - see INSTRUCTIONS.md.
